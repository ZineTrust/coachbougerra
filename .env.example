# Coach Bougerra — environment settings. Copy to .env.local (local) or set them in your host (Render…).

# The owner account (Coach Bougerra) is created from these the very first time the server starts.
# Afterwards the password lives in the database: change it from the workspace profile page.
OWNER_NAME=Coach Bougerra
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-long-password

# Real Postgres (Supabase, Render, …). Leave empty locally: an embedded database is used
# and stored in .data/ (that folder is git-ignored and safe to delete to start fresh).
DATABASE_URL=

# Notifications to phones (web push). Generate a pair once with:  npx web-push generate-vapid-keys
# The public key is safe to expose; the private key must stay secret. Keep the same pair for ever,
# otherwise members have to re-enable notifications on their devices.
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Videos sent from a phone are kept in an S3-compatible bucket (Backblaze B2 is the one this was made for,
# see README "Videos on Backblaze B2"). Without these four lines the upload button is off and only YouTube /
# Vimeo links work. Optional: VIDEO_MAX_MB (default 2048), STORAGE_QUOTA_GB (default 10, display only).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_KEY_ID=
STORAGE_KEY_SECRET=
# Only for the one-time scripts/storage-cors.mjs run (Backblaze: the account's master key). Remove afterwards.
STORAGE_ADMIN_KEY_ID=
STORAGE_ADMIN_KEY_SECRET=

# Optional: the public address of the site (a custom domain), used in invitation links and their QR code.
# Left empty, the address is read from each request.
SITE_URL=
